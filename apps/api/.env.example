# S3_BUCKET="bodas-archivos"
# S3_ENDPOINT="https://endpoint-s3-compatible"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# URL pública exacta donde viven las invitaciones.
PUBLIC_APP_URL="http://localhost:3000"
INVITATION_TOKEN_SECRET="another-random-secret-at-least-32-characters"
