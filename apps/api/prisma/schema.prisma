generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "mysql"
 url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 PLANNER
 ASSISTANT
 COUPLE
}
enum WeddingStatus { 
 PLANNING
 CONFIRMED
 COMPLETED
 CANCELLED
}
enum LeadStatus {
 PROSPECT
 QUOTED
 CONTRACTED
 DISCARDED
}
enum TaskStatus {
 TODO
 IN_PROGRESS
 DONE
 CANCELLED
}
enum RsvpStatus {
 PENDING
 ACCEPTED
 DECLINED
}
enum InvitationStatus {
 DRAFT
 PUBLISHED
 CLOSED
 REVOKED
}
enum PaymentDirection {
 RECEIVABLE
 PAYABLE
}
enum PaymentStatus {
 PENDING
 PARTIAL
 PAID
 VOID
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 role Role
 active Boolean @default(true)
 sessions Session[]
 assignments WeddingAssignment[]
 coupleWedding Wedding? @relation("CoupleAccess")
 tasks Task[] @relation("TaskAssignee")
 audit AuditLog[]
}
model Activity {
 id String @id @default(cuid())
 weddingId String
 title String
 type String
 startsAt DateTime
 endsAt DateTime?
 responsible String?
 notes String? @db.Text
 wedding Wedding @relation(fields:[weddingId],references:[id])
 @@index([weddingId,startsAt])
}
model Session {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 expiresAt DateTime
 revokedAt DateTime?
 user User @relation(fields:[userId],references:[id])
 @@index([userId,expiresAt])
}
model Wedding {
 id String @id @default(cuid())
 title String
 timezone String @default("America/Mexico_City")
 currency String @default("MXN")
 date DateTime?
 ceremonyVenue String?
 receptionVenue String?
 dressCode String?
 program String? @db.Text
 giftsInfo String? @db.Text
 galleryUrl String?
 isPublished Boolean @default(false)
 status WeddingStatus @default(PLANNING)
 leadStatus LeadStatus @default(CONTRACTED)
 clientId String? @unique
 client Client? @relation(fields:[clientId],references:[id])
 coupleUserId String? @unique
 coupleUser User? @relation("CoupleAccess",fields:[coupleUserId],references:[id])
 assignments WeddingAssignment[]
 tasks Task[]
 guestGroups GuestGroup[]
 invitations Invitation[]
 obligations Obligation[]
 audit AuditLog[]
 activities Activity[]
 @@index([status,date])
}
model Client {
 id String @id @default(cuid())
 partnerOneName String
 partnerTwoName String?
 email String?
 phone String?
 estimatedGuests Int?
 estimatedBudget Decimal? @db.Decimal(12,2)
 style String?
 preferences String? @db.Text
 internalNotes String? @db.Text
 createdAt DateTime @default(now())
 wedding Wedding?
 @@index([email])
}
model WeddingAssignment {
 weddingId String
 userId String
 canViewFinance Boolean @default(false)
 wedding Wedding @relation(fields:[weddingId],references:[id])
 user User @relation(fields:[userId],references:[id])
 @@id([weddingId,userId])
}
model Task {
 id String @id @default(cuid())
 weddingId String
 title String
 category String
 priority Int @default(2)
 dueAt DateTime?
 status TaskStatus @default(TODO)
 assigneeId String?
 internalOnly Boolean @default(true)
 wedding Wedding @relation(fields:[weddingId],references:[id])
 assignee User? @relation("TaskAssignee",fields:[assigneeId],references:[id])
 @@index([weddingId,status,dueAt])
}
model GuestGroup {
 id String @id @default(cuid())
 weddingId String
 name String
 contactPhone String?
 maxPasses Int @default(1)
 wedding Wedding @relation(fields:[weddingId],references:[id])
 guests Guest[]
 invitation Invitation?
 @@index([weddingId,name])
}
model Guest {
 id String @id @default(cuid())
 groupId String
 firstName String
 lastName String?
 phone String?
 email String?
 dietaryNotes String?
 group GuestGroup @relation(fields:[groupId],references:[id])
 @@index([groupId])
}
model Invitation {
 id String @id @default(cuid())
 weddingId String
 groupId String @unique
 tokenHash String @unique
 tokenCiphertext String?
 status InvitationStatus @default(DRAFT)
 responseDeadline DateTime?
 allowChanges Boolean @default(true)
 wedding Wedding @relation(fields:[weddingId],references:[id])
 group GuestGroup @relation(fields:[groupId],references:[id])
 response RsvpResponse?
 history RsvpHistory[]
 @@index([weddingId,status])
}
model RsvpResponse {
 id String @id @default(cuid())
 invitationId String @unique
 status RsvpStatus @default(PENDING)
 attendeeCount Int @default(0)
 message String?
 updatedAt DateTime @updatedAt
 invitation Invitation @relation(fields:[invitationId],references:[id])
}
model RsvpHistory {
 id String @id @default(cuid())
 invitationId String
 status RsvpStatus
 attendeeCount Int
 message String?
 createdAt DateTime @default(now())
 invitation Invitation @relation(fields:[invitationId],references:[id])
 @@index([invitationId,createdAt])
}
model Obligation {
 id String @id @default(cuid())
 weddingId String
 description String
 direction PaymentDirection
 amount Decimal @db.Decimal(12,2)
 paidAmount Decimal @default(0) @db.Decimal(12,2)
 currency String @default("MXN")
 dueDate DateTime?
 status PaymentStatus @default(PENDING)
 wedding Wedding @relation(fields:[weddingId],references:[id])
 payments Payment[]
 @@index([weddingId,status,dueDate])
}
model Payment {
 id String @id @default(cuid())
 obligationId String
 idempotencyKey String @unique
 amount Decimal @db.Decimal(12,2)
 paidAt DateTime
 reference String?
 obligation Obligation @relation(fields:[obligationId],references:[id])
}
model AuditLog {
 id String @id @default(cuid())
 weddingId String?
 actorId String?
 action String
 entityType String
 entityId String
 metadata Json?
 wedding Wedding? @relation(fields:[weddingId],references:[id])
 actor User? @relation(fields:[actorId],references:[id])
 @@index([weddingId])
}
model FileRecord {
 id String @id @default(cuid())
 weddingId String
 taskId String?
 name String
 mimeType String
 path String
 visibility String @default("INTERNAL")
 createdAt DateTime @default(now())
 @@index([weddingId,visibility])
 @@index([weddingId,taskId])
}
model TaskComment {
 id String @id @default(cuid())
 taskId String
 authorId String
 body String @db.Text
 createdAt DateTime @default(now())
 @@index([taskId,createdAt])
}
model Vendor {
 id String @id @default(cuid())
 name String
 category String
 contactName String?
 phone String?
 email String?
 services String? @db.Text
 priceRange String?
 rating Int?
 internalNotes String? @db.Text
 createdAt DateTime @default(now())
 @@index([category,name])
}
